<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/dashboardFragment2">

    <fragment
        android:id="@+id/dashboardFragment2"
        android:name="com.example.opsmonitor.ui.DashboardFragment"
        android:label="fragment_dashboard"
        tools:layout="@layout/fragment_dashboard" >
        <action
            android:id="@+id/action_dashboardFragment2_to_serverListFragment"
            app:destination="@id/serverListFragment" />
        <action
            android:id="@+id/action_dashboardFragment2_to_registerActivity"
            app:destination="@id/registerActivity" />
        <action
            android:id="@+id/action_dashboardFragment2_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_dashboardFragment2_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/serverListFragment"
        android:name="com.example.opsmonitor.ui.ServerListFragment"
        android:label="fragment_server_list"
        tools:layout="@layout/fragment_server_list">
        <action
            android:id="@+id/action_serverListFragment_to_serverDetailFragment"
            app:destination="@id/serverDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/serverDetailFragment"
        android:name="com.example.opsmonitor.ui.ServerDetailFragment"
        android:label="fragment_server_detail"
        tools:layout="@layout/fragment_server_detail" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.opsmonitor.ui.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.opsmonitor.ui.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" />

    <activity
        android:id="@+id/loginActivity"
        android:name="com.example.opsmonitor.ui.LoginActivity"
        android:label="activity_login"
        tools:layout="@layout/activity_login" />
    <activity
        android:id="@+id/registerActivity"
        android:name="com.example.opsmonitor.ui.RegisterActivity"
        android:label="activity_register"
        tools:layout="@layout/activity_register" />

</navigation>